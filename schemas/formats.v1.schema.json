{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/3leaps/structcorpus/schemas/formats.v1.schema.json",
  "title": "structcorpus format registry v1 (DDR-0014)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "formats"],
  "properties": {
    "schema_version": {"const": "formats/v1"},
    "formats": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {"$ref": "#/definitions/format"}
    }
  },
  "definitions": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dialects"],
      "anyOf": [{"required": ["cases"]}, {"required": ["recipes"]}],
      "dependencies": {
        "fixtures": ["cases"],
        "recipes": ["generators", "generated_input_extension"],
        "generators": ["recipes"],
        "generated_input_extension": ["recipes"]
      },
      "properties": {
        "status": {"const": "active"},
        "dialects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"}
        },
        "generated_input_extension": {"type": "string", "pattern": "^\\.[a-z0-9]{1,15}$"},
        "cases": {"type": "string", "pattern": "^manifests/[a-z][a-z0-9-]{0,31}/cases\\.jsonl$"},
        "profiles": {"type": "string", "pattern": "^manifests/[a-z][a-z0-9-]{0,31}/profiles$"},
        "span_conventions": {"type": "string", "pattern": "^manifests/[a-z][a-z0-9-]{0,31}/span-conventions$"},
        "upstreams": {"type": "string", "pattern": "^manifests/[a-z][a-z0-9-]{0,31}/upstreams\\.lock\\.json$"},
        "fixtures": {"type": "string", "pattern": "^fixtures/[a-z][a-z0-9-]{0,31}$"},
        "recipes": {"type": "string", "pattern": "^recipes/[a-z][a-z0-9-]{0,31}$"},
        "generators": {"type": "string", "pattern": "^generators/[a-z][a-z0-9-]{0,31}$"}
      }
    }
  }
}
