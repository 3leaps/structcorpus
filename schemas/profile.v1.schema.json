{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/3leaps/structcorpus/schemas/profile.v1.schema.json",
  "title": "structcorpus expectation profile v1 (DDR-0003)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "dialect", "scalar_schema", "policy", "cites", "description"],
  "properties": {
    "schema_version": {"const": "profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "dialect": {"enum": ["yaml-1.2.2"]},
    "scalar_schema": {"enum": ["core", "json", "failsafe"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_keys", "merge_keys", "integer_range", "documents", "unknown_tags"],
      "properties": {
        "duplicate_keys": {"enum": ["reject"]},
        "merge_keys": {"enum": ["reject", "apply", "plain-key"]},
        "integer_range": {"enum": ["unbounded", "i128-u128"]},
        "documents": {"enum": ["single", "stream"]},
        "unknown_tags": {"enum": ["tagged-str", "reject"]},
        "flow_indentation": {"enum": ["lenient", "strict"], "description": "Optional. When absent, the setting is whatever the cited specification revision states."}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_bytes", "max_depth", "max_nodes", "max_expanded_nodes", "max_alias_events", "max_owned_bytes", "max_scalar_bytes", "max_key_bytes", "max_mapping_entries", "max_documents", "max_output_bytes", "max_warnings"],
      "description": "Explicit resource limits, named exactly as the cited specification's Limits fields.",
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 255},
        "max_nodes": {"type": "integer", "minimum": 1},
        "max_expanded_nodes": {"type": "integer", "minimum": 1},
        "max_alias_events": {"type": "integer", "minimum": 1},
        "max_owned_bytes": {"type": "integer", "minimum": 1},
        "max_scalar_bytes": {"type": "integer", "minimum": 1},
        "max_key_bytes": {"type": "integer", "minimum": 1},
        "max_mapping_entries": {"type": "integer", "minimum": 1},
        "max_documents": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "max_warnings": {"type": "integer", "minimum": 1}
      }
    },
    "cites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "revision"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
