extends: default
rules:
  document-start: disable
  line-length:
    max: 160
    level: warning
  truthy:
    # GitHub Actions uses an `on:` key for workflow triggers.
    allowed-values: ["true", "false", "on"]
    check-keys: false
  comments:
    min-spaces-from-content: 2
  indentation:
    spaces: 2
    indent-sequences: consistent

ignore:
  - .git/
  - fixtures/
  - expected/
